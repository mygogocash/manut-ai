{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Manut AI",
  "version": "0.1.0",
  "identifier": "xyz.manut.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5207",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Manut AI",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "media-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost data: blob: wss://manut.xyz wss://*.manut.xyz",
        "worker-src": "'self' blob:",
        "frame-src": "http://localhost:* https://localhost:*",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' 'wasm-unsafe-eval' http://localhost:5207",
        "style-src": "'self' 'unsafe-inline' http://localhost:5207",
        "img-src": "'self' data: blob: http://localhost:5207",
        "media-src": "'self' data: blob:",
        "font-src": "'self' data: http://localhost:5207",
        "connect-src": "'self' ipc: http://ipc.localhost data: blob: http://localhost:5207 ws://localhost:5207 ws://127.0.0.1:* wss://manut.xyz wss://*.manut.xyz",
        "worker-src": "'self' blob:",
        "frame-src": "http://localhost:* https://localhost:*",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../NOTICE.md": "NOTICE.md",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Productivity",
    "shortDescription": "Chat, an AI team and a code editor for your shop",
    "copyright": "Manut AI. Portions (c) 2026 oh-my-hermes contributors, MIT License.",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["manut"]
      }
    }
  }
}
