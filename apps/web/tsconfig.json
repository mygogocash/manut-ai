{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@manut/approval-core": ["../../packages/approval-core/src/index.ts"],
      "@manut/format": ["../../packages/format/src/index.ts"],
      "@manut/people-rules": ["../../packages/people-rules/src/index.ts"],
      "@manut/promptpay": ["../../packages/promptpay/src/index.ts"],
      "@manut/routine-rules": ["../../packages/routine-rules/src/index.ts"]
    }
  },
  "include": ["src", "test", "e2e", "vite.config.ts", "playwright.config.ts"]
}
