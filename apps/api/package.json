{
  "name": "@manut/api",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "wrangler dev -c wrangler.jsonc -c wrangler.web.jsonc",
    "check": "wrangler deploy --dry-run --outdir=.wrangler/dry-run",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node scripts/admin-access-contract.mjs && node scripts/one-origin-contract.mjs",
    "test:access": "node scripts/admin-access-contract.mjs",
    "test:origin": "node scripts/one-origin-contract.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.6.0",
    "@cloudflare/workers-types": "5.20261108.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "wrangler": "^4.158.0"
  },
  "dependencies": {
    "@manut/approval-core": "workspace:*",
    "@manut/shop-memory": "workspace:*"
  }
}
