  },
  // Proposed namespace IDs are distinct within this source tree. Before any
  // deploy, the owner must check account-wide allocation and replace conflicts
  // in every environment. This patch has not queried a Cloudflare account.
  // The relay limiters (2026100404/05, and 14/15, 24/25 and 34/35 in dev,
  // staging and prod) are proposed the same way and are equally unverified.
  // So are the pilot limiters (2026112321/22 here, 23/24, 25/26 and 27/28
  // in dev, staging and prod), and the outposts' limiter (2026112329 here,
  // 30, 31 and 32 in dev, staging and prod), which covers an outpost's
  // heartbeat, redeem and browser steps (browser-control.ts), keyed per
  // source address. The email sign-in code limiter follows them (2026112333
  // here, 34, 35 and 36 in dev, staging and prod): on 24 Nov 2026 the ids
  // 2026112301 to 32 clashed with nothing in the account, whose other
  // limiters use only 1001 and 1002 (docs/handoff.md).
  // The Google callback's limiter comes next (2026112337 here, 38, 39 and 40
  // in dev, staging and prod; google-connect.ts), keyed per source address;
  // its ids have not been checked against the account's limiters yet.
  // Making a shop of one's own comes after it (2026112341 here, 42, 43 and 44
  // in dev, staging and prod; self-serve.ts), keyed per source address and
  // counted only while sign-ups are open; its ids have not been checked
  // against the account's limiters yet either. The security review's two
  // follow (docs/decisions.md, 24 Nov 2026): a person's deletion of their own
  // data, per source address (2026112345 here, 46, 47 and 48 in dev, staging
  // and prod), and opening a shop session, per signed-in person (2026112349
  // here, 50, 51 and 52; session-limits.ts). Neither is checked against the
  // account's limiters yet. Artifact links' public read comes next
  // (2026112353 here, 54, 55 and 56 in dev, staging and prod; artifacts.ts),
  // per source address on the artifact origin's host; not checked against the
  // account's limiters either.
  "ratelimits": [
    {
      "name": "AUTH_EXCHANGE_LIMITER",
      "namespace_id": "2026112301",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    // Asking for a sign-in code by email (email-code.ts), keyed and configured as the exchange's.
    {
      "name": "AUTH_CODE_LIMITER",
      "namespace_id": "2026112333",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "AUTH_SESSION_LIMITER",
      "namespace_id": "2026112302",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "LINEAR_INBOUND_LIMITER",
      "namespace_id": "2026112303",
      "simple": {
        "limit": 300,
        "period": 60
      }
    },
    // Relay upgrade gates, keyed per IPv4 address or IPv6 /64 (A4b).
    // Proposed ids, unverified against the account like the rest.
    {
      "name": "RELAY_HOST_LIMITER",
      "namespace_id": "2026112304",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "RELAY_PHONE_LIMITER",
      "namespace_id": "2026112305",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    // Manut AI pilot ingress (pilot.ts): LINE webhooks, keyed per source
    // address like the Linear webhook, and the owner's approval routes,
    // which the page polls while a send settles. Proposed ids, unverified
    // against the account like the rest.
    {
      "name": "LINE_INBOUND_LIMITER",
      "namespace_id": "2026112321",
      "simple": {
        "limit": 300,
        "period": 60
      }
    },
    {
      "name": "PILOT_APPROVAL_LIMITER",
      "namespace_id": "2026112322",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "OUTPOST_LIMITER",
      "namespace_id": "2026112329",
      "simple": {
        "limit": 300,
        "period": 60
      }
    },
    {
      "name": "GOOGLE_CALLBACK_LIMITER",
      "namespace_id": "2026112337",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    // Making a shop of one's own (self-serve.ts), per source address, counted only while sign-ups are open.
    {
      "name": "SELF_SERVE_SHOP_LIMITER",
      "namespace_id": "2026112341",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    // A person's deletion of their own data (DELETE /v1/tenant/data), per source address, before the session is read.
    {
      "name": "TENANT_DELETE_LIMITER",
      "namespace_id": "2026112345",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    // Opening a shop session (POST /v1/shops/session, POST /v1/people/session), per signed-in person (session-limits.ts).
