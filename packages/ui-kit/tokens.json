{
  "$description": "Manut AI design tokens, version 0.2, 23 November 2026. The source of truth is the two token blocks at the top of app.css on this canvas. Keep this file in step with them. Colours are sRGB hex, sizes are CSS px.",
  "version": "0.2",
  "updated": "2026-11-23",
  "themeSwitch": {
    "canvas": "data-t=\"dark\" on a board's root element",
    "app": "the class \"dark\" on the page, as shadcn/ui expects"
  },
  "color": [
    { "name": "page", "var": "--main", "light": "#FBFAF7", "dark": "#171716", "use": "Page ground" },
    { "name": "sideMenu", "var": "--side", "light": "#F3F2EE", "dark": "#111110", "use": "Side menu ground" },
    { "name": "surface", "var": "--aui-surface", "alias": "--bg", "light": "#FFFFFF", "dark": "#1F1F1D", "use": "Cards, fields, the ask box" },
    { "name": "overlay", "var": "--aui-overlay", "light": "#FFFFFF", "dark": "#262624", "use": "Menus and dialogs" },
    { "name": "quietFill", "var": "--soft", "light": "#F4F3EF", "dark": "#252523", "use": "The owner's message, code blocks, the mode switch" },
    { "name": "band", "var": "--aui-subtle", "alias": "--band", "light": "#F1F0EB", "dark": "#222220", "use": "Section bands, neutral tags" },
    { "name": "hover", "var": "--hov", "light": "#ECEAE4", "dark": "#2B2B28", "use": "Hovered and current rows" },
    { "name": "hairline", "var": "--aui-border", "alias": "--line", "light": "#E7E5DF", "dark": "#30302D", "use": "Edges and dividers. Decoration only" },
    { "name": "strongEdge", "var": "--aui-border-strong", "light": "#8A8881", "dark": "#75746E", "use": "Fields, checkboxes, the off switch. 3 to 1 or better" },
    { "name": "ink", "var": "--aui-ink", "alias": "--ink", "light": "#111110", "dark": "#F3F2EE", "use": "Text" },
    { "name": "secondLine", "var": "--aui-muted", "alias": "--mut", "light": "#6A6964", "dark": "#A3A29C", "use": "Second-line text" },
    { "name": "placeholder", "var": "--aui-placeholder", "light": "#737269", "dark": "#8F8E88", "use": "Placeholder text in a field" },
    { "name": "primary", "var": "--aui-primary", "alias": "--pri", "light": "#1A1A19", "dark": "#F3F2EE", "use": "The primary button" },
    { "name": "onPrimary", "var": "--aui-on-primary", "alias": "--onpri", "light": "#FFFFFF", "dark": "#111110", "use": "Text on the primary button" },
    { "name": "focus", "var": "--aui-focus", "light": "#2F7FE0", "dark": "#8CC4FF", "use": "Keyboard focus ring" },
    { "name": "infoText", "var": "--aui-info", "alias": "--bluei", "light": "#1764C0", "dark": "#8CC4FF", "use": "Working tag text" },
    { "name": "infoFill", "var": "--bluebg", "light": "#E8F2FE", "dark": "#13283F", "use": "Working tag fill" },
    { "name": "successText", "var": "--aui-success", "alias": "--oki", "light": "#177A3B", "dark": "#5FD68A", "use": "Checked tag text" },
    { "name": "successFill", "var": "--okbg", "light": "#E4F5EA", "dark": "#12301E", "use": "Checked tag fill, added lines" },
    { "name": "dangerText", "var": "--aui-danger", "alias": "--erri", "light": "#C62F35", "dark": "#FF8A8E", "use": "Failed tag and error text" },
    { "name": "dangerFill", "var": "--errbg", "light": "#FBE9EA", "dark": "#3A1719", "use": "Failed tag fill, removed lines" },
    { "name": "warningText", "var": "--aui-warning", "light": "#7D5E0E", "dark": "#E0B43A", "use": "Warning text where a kit component needs one" },
    { "name": "waitingFill", "var": "--warnbg", "light": "#F6EFD3", "dark": "#3A3318", "use": "Needs you tag and count" }
  ],
  "fixedColor": [
    { "name": "buddyBlue", "var": "--aui-blue", "alias": "--blue", "value": "#4DA3FF", "use": "Buddy's face, working dots. Never text on light" },
    { "name": "green", "var": "--aui-green", "alias": "--ok", "value": "#22B455", "use": "Done dots and bars" },
    { "name": "amber", "var": "--aui-amber", "value": "#E0B43A", "use": "Waiting dots" },
    { "name": "red", "var": "--aui-red", "value": "#E5484D", "use": "Failed dots" },
    { "name": "teamNam", "value": "#CDDDEB", "use": "Nam, sales chat" },
    { "name": "teamPim", "value": "#DBD6EC", "use": "Pim, content" },
    { "name": "teamTon", "value": "#CEDFCE", "use": "Ton, books" },
    { "name": "teamKit", "value": "#E6D9C2", "use": "Kit, engineer" },
    { "name": "owner", "value": "#EFD3CC", "use": "The owner" },
    { "name": "spare", "value": "#EDE1B6", "use": "A sixth team member" },
    { "name": "initial", "value": "#111110", "use": "The letter on a team colour" },
    { "name": "markGround", "value": "#E3E1DB", "use": "Brand mark ground, draft 1" },
    { "name": "markFigure", "value": "#1F2022", "use": "Brand mark figure, draft 1" },
    { "name": "faceInk", "var": "--face-ink", "value": "#1F2022", "use": "Hair, eyes and lines of a team face, the same in both themes" }
  ],
  "shadow": {
    "var": "--aui-shadow-card",
    "alias": "--sh",
    "light": "0 1px 2px rgba(17,17,16,.05), 0 10px 28px -14px rgba(17,17,16,.16)",
    "dark": "0 1px 2px rgba(0,0,0,.4), 0 10px 28px -14px rgba(0,0,0,.7)",
    "use": "The ask box, menus, dialogs, the morning brief. Nothing else has a shadow"
  },
  "radius": [
    { "name": "small", "var": "--rad-sm", "value": 6, "use": "Checkbox, key cap" },
    { "name": "control", "var": "--rad", "value": 8, "use": "Buttons, fields, rows, chips" },
    { "name": "surface", "var": "--rad-lg", "value": 12, "use": "Cards, banners, menus, code blocks" },
    { "name": "large", "var": "--rad-xl", "value": 16, "use": "Ask box, dialogs, the owner's message" },
    { "name": "pill", "var": "--rad-pill", "value": 999, "use": "Tags, switches, faces, send" }
  ],
  "font": [
    { "name": "interface", "var": "--aui-font", "value": "'Geist', 'IBM Plex Sans Thai', -apple-system, BlinkMacSystemFont, system-ui, sans-serif", "weights": [400, 500, 600] },
    { "name": "reading", "var": "--font-read", "value": "'Source Serif 4', 'Noto Serif Thai', Georgia, serif", "weights": [400, 600] },
    { "name": "code", "var": "--aui-font-mono", "value": "'Geist Mono', ui-monospace, SFMono-Regular, Menlo, monospace", "weights": [400, 500] }
  ],
  "type": [
    { "name": "brandDisplay", "size": 72, "lineHeight": 1.05, "weight": 600, "tracking": "-0.04em", "class": null },
    { "name": "sheetTitle", "size": 44, "lineHeight": 1.05, "weight": 600, "tracking": "-0.04em", "class": "sheet h1" },
    { "name": "greeting", "size": 36, "lineHeight": 1.1, "weight": 600, "tracking": "-0.04em", "class": "lockup" },
    { "name": "figure", "size": 28, "lineHeight": 1.15, "weight": 600, "tracking": "-0.03em", "class": "num" },
    { "name": "section", "size": 20, "lineHeight": 1.5, "weight": 600, "tracking": "-0.02em", "class": "sheet h2" },
    { "name": "consequence", "size": 17, "lineHeight": 1.4, "weight": 500, "tracking": "-0.01em", "class": "big" },
    { "name": "reading", "size": 17, "lineHeight": 1.65, "weight": 400, "tracking": "0", "class": "prose" },
    { "name": "ask", "size": 15, "lineHeight": 1.5, "weight": 400, "tracking": "0", "class": "askin, you" },
    { "name": "body", "size": 14, "lineHeight": 1.5, "weight": 400, "tracking": "0", "class": "r" },
    { "name": "label", "size": 13, "lineHeight": 1.5, "weight": 500, "tracking": "0", "class": "btn, tab, chip" },
    { "name": "note", "size": 12.5, "lineHeight": 1.5, "weight": 400, "tracking": "0", "class": "hint, help" },
    { "name": "tag", "size": 12, "lineHeight": 1.5, "weight": 500, "tracking": "0", "class": "tag, spec" },
    { "name": "initial", "size": 11, "lineHeight": 1.5, "weight": 600, "tracking": "0", "class": "av" },
    { "name": "code", "size": 12, "lineHeight": 1.6, "weight": 400, "tracking": "0", "class": "codeb" }
  ],
  "space": {
    "steps": [4, 8, 12, 16, 24, 32, 48, 64],
    "fineSteps": [2, 6, 10, 14],
    "use": "Fine steps are only for the inside of a small control"
  },
  "size": [
    { "name": "screenBoard", "value": "1360 x 920" },
    { "name": "sideMenu", "value": 196 },
    { "name": "topBar", "value": 52 },
    { "name": "askBoxMaxWidth", "value": 696 },
    { "name": "readingColumnMaxWidth", "value": 736 },
    { "name": "rightPanelMinWidth", "value": 300 },
    { "name": "button", "value": 34 },
    { "name": "field", "value": 40 },
    { "name": "listRow", "value": 44 },
    { "name": "chip", "value": 32 },
    { "name": "pill", "value": 28 },
    { "name": "pressArea", "value": 44 },
    { "name": "icon", "value": 16, "stroke": 1.4 },
    { "name": "focusRing", "value": 2, "offset": 2 }
  ],
  "motion": {
    "ease": { "var": "--aui-ease", "value": "cubic-bezier(.22, 1.25, .36, 1)" },
    "plainEase": "cubic-bezier(.22, 1, .36, 1)",
    "moves": [
      { "name": "rise", "seconds": 0.5, "staggerMs": 50, "use": "Chips, grids and toasts arriving" },
      { "name": "pop", "seconds": 0.45, "use": "A decision settling into its row" },
      { "name": "grow", "seconds": 0.9, "use": "Bars and meters filling" },
      { "name": "shim", "seconds": 2.4, "loops": true, "use": "The working line" },
      { "name": "pulse", "seconds": 1.6, "loops": true, "use": "The working dot" },
      { "name": "roll6", "seconds": 12, "loops": true, "use": "Working words, five words per loop" },
      { "name": "press", "seconds": 0.2, "use": "A button shrinking to 97% while held" },
      { "name": "switch", "seconds": 0.25, "use": "The switch thumb" },
      { "name": "hover", "seconds": 0.15, "use": "A fill fading in" }
    ],
    "reducedMotion": "Every animation and transition is off. The shimmer becomes plain second-line text"
  }
}
